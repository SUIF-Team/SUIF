APP_NAME=SUIF
APP_ENV=local
APP_KEY=base64:h6/zB3Ljwzfl7TZ//6hYec/FnRgDhxHrWSBK14v4JQ4=
APP_DEBUG=true
APP_URL=http://localhost:8088

# Puerto HTTP definitivo de SUIF en el equipo anfitrión.
APP_PORT=8088

APP_LOG=single
APP_LOG_LEVEL=debug

# Base de datos — PostgreSQL 16 (motor principal del proyecto)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=suif
DB_USERNAME=suif
DB_PASSWORD=suif123

# Puerto de PostgreSQL expuesto en el equipo anfitrión.
DB_FORWARD_PORT=5433

# Sesiones
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Cache
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
BROADCAST_DRIVER=null

# Mail (configurar según proveedor)
MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=noreply@suif.unam.mx
MAIL_MAILER=log
MAIL_FROM_NAME="${APP_NAME}"


# Filesystem
FILESYSTEM_DRIVER=local
