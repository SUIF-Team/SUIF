# =============================================================================
# SUIF — storage/.htaccess
# Bloquear TODO acceso web directo a esta carpeta.
# Los archivos se sirven ÚNICAMENTE a través de ArchivoController.php
# =============================================================================

# Apache 2.4+
Require all denied

# Apache 2.2 (compatibilidad XAMPP local)
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>

# Por si acaso, deshabilitar ejecución de scripts
Options -ExecCGI -Indexes
AddHandler cgi-script .php .php3 .php4 .php5 .pl .py .jsp .asp .sh .cgi
