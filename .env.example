APP_NAME=SUIF
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost/SUIF/public

LOG_CHANNEL=stack

# Base de datos — PostgreSQL 16 (motor principal del proyecto)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=suif
DB_USERNAME=postgres
DB_PASSWORD=

# Sesiones
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Cache
CACHE_DRIVER=file
QUEUE_CONNECTION=sync

# Mail (configurar según proveedor)
MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=noreply@suif.unam.mx
MAIL_FROM_NAME="${APP_NAME}"

# Redis (opcional)
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Filesystem
FILESYSTEM_DRIVER=local
