APP_NAME=SUIF
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Logs: el canal daily crea un archivo por día y conserva LOG_DAILY_DAYS.
LOG_CHANNEL=daily
LOG_LEVEL=debug
LOG_DAILY_DAYS=14

# Base de datos — PostgreSQL 18 (motor principal del proyecto)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=suif
DB_USERNAME=suif
DB_PASSWORD=

# Sesiones
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Cache
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
BROADCAST_DRIVER=null

# Mail: en desarrollo, 'log' escribe los correos en storage/logs.
# En producción DEBE ser smtp con el relevo institucional real: con 'log'
# las claves de acceso quedarían en texto plano dentro del log del servidor.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=noreply@suif.unam.mx
MAIL_FROM_NAME="${APP_NAME}"

# Redis (opcional)
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Filesystem
FILESYSTEM_DRIVER=local
