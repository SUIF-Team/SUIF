<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <!-- Sin esto las pruebas heredan el APP_URL del .env: en el servidor
             route() y asset() salen con su IP y LandingTest la confunde con
             una dirección escrita a mano. -->
        <env name="APP_URL" value="http://localhost"/>
        <!-- Con el driver 'file' las pruebas leerían storage/framework/down
             del servidor real y responderían 503 durante un mantenimiento;
             con 'array' cada corrida empieza fuera de mantenimiento. -->
        <env name="APP_MAINTENANCE_DRIVER" value="array"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- Sin esto, las pruebas que simulan un fallo de correo escriben en el
             log real; corridas como root, crean el log del día con dueño root
             y Apache ya no puede escribir en él. -->
        <env name="LOG_CHANNEL" value="null"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
